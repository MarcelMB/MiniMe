{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["**", "!src/stream/pkg", "!public/readme"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "css": { "formatter": { "enabled": false } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": { "useExhaustiveDependencies": "off" },
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "a11y": {
        "useAriaPropsForRole": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useSemanticElements": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
