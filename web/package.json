{
  "name": "minime-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --mode browser",
    "wasm": "cd ../rust/minime-core && RUSTFLAGS='-C target-feature=+simd128' wasm-pack build --release --target web --out-dir ../../web/src/stream/pkg",
    "build": "tsc --noEmit && vite build",
    "build:browser": "tsc --noEmit && vite build --mode browser",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.browser.config.ts",
    "e2e": "playwright test",
    "e2e:stream": "playwright test -c playwright.stream.config.ts",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
